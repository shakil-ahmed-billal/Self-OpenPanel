{
  "name": "@openpanel/core",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./modules/*.constants": "./src/modules/*.constants.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate",
    "codegen": "bun scripts/download-geo.ts && bun scripts/get-datacenter-asns.ts",
    "gen:asns": "bun scripts/get-datacenter-asns.ts",
    "gen:bots": "bun scripts/get-bots.ts && biome format --write ./src/modules/ingest/src/bots/bots.ts",
    "gen:referrers": "bun scripts/get-referrers.ts && biome format --write ./src/shared/referrers/index.ts",
    "with-env": "dotenv -e ../../.env -c --"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.83",
    "@ai-sdk/openai": "4.0.97",
    "@babel/parser": "7.29.7",
    "@bull-board/api": "9.6.0",
    "@bull-board/elysia": "9.6.0",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "@hyperdx/node-opentelemetry": "catalog:",
    "@maxmind/geoip2-node": "6.1.0",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@node-rs/argon2": "2.0.2",
    "@openpanel/db": "workspace:*",
    "@openpanel/redis": "workspace:*",
    "@openpanel/sdk": "workspace:*",
    "@openpanel/shared": "workspace:*",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@trpc/server": "11.6.0",
    "ai": "7.0.144",
    "arctic": "2.3.0",
    "better-auth": "1.7.10",
    "bullmq": "6.3.3",
    "cheerio": "1.1.2",
    "date-fns": "3.3.1",
    "elysia": "1.4.30",
    "fast-deep-equal": "3.1.3",
    "fast-json-stable-hash": "1.0.3",
    "js-yaml": "4.1.1",
    "kafkajs": "2.2.4",
    "lru-cache": "11.5.1",
    "mathjs": "12.3.2",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "prisma-error-enum": "0.1.3",
    "prom-client": "15.1.3",
    "ramda": "0.29.1",
    "re2js": "2.9.0",
    "short-unique-id": "5.0.3",
    "superjson": "2.2.2",
    "uuid": "9.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clickhouse/client": "1.18.5",
    "@openpanel/tsconfig": "workspace:*",
    "@types/js-yaml": "4.0.9",
    "@types/ramda": "0.31.0",
    "@types/uuid": "10.0.0",
    "bun-types": "1.4.4",
    "tar": "7.4.3",
    "typescript": "catalog:"
  }
}
